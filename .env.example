# Base URL of the backend API.
#
# Leave empty to make same-origin relative requests (e.g. /api/core/Auth/Token)
# proxied to the real backend by vite.config.ts's server.proxy — a workaround
# for the backend's CORS not being configured for the Vite dev origin yet.
# See README's "Backend integration" section.
#
# Once CORS is fixed backend-side (or for a production build, where the dev
# proxy doesn't apply), set this to the real absolute URL instead:
# VITE_API_BASE_URL=https://localhost:44318
VITE_API_BASE_URL=
